{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "functions": {
    "api/index.ts": {
      "maxDuration": 120,
      "includeFiles": "fonts/**"
    }
  },
  "rewrites": [{ "source": "/(.*)", "destination": "/api" }]
}
