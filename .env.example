# --- Server ---
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
FRONTEND_URL=http://localhost:3000

# --- Database (MongoDB Atlas or local replica set; transactions need a replica set) ---
# MONGODB_URI=mongodb://localhost:27017/ablesprout?replicaSet=rs0
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/ablesprout

# --- Auth (use long random strings: `openssl rand -hex 48`) ---
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars
JWT_ACCESS_TTL=1h
JWT_REFRESH_TTL_DAYS=7
# All API requests allowed per IP per 15 minutes (raise if a whole school shares one IP)
API_RATE_LIMIT=600
# Logins/refreshes allowed per IP per 15 minutes
AUTH_RATE_LIMIT=20

# --- LLM ---
# anthropic | openai | mock (mock = offline canned output for local demos and E2E tests only)
LLM_PROVIDER=anthropic
LLM_API_KEY=
# Defaults to claude-opus-5-5 for anthropic. Required for openai.
LLM_MODEL=claude-opus-5-5

# --- PDF fonts (optional; the Docker image installs these) ---
DYSLEXIA_FONT_PATH=/usr/share/fonts/opentype/opendyslexic/OpenDyslexic-Regular.otf
HINDI_FONT_PATH=/usr/share/fonts/truetype/noto/NotoSansDevanagari-Regular.ttf

# --- Frontend proxy (must match the UI's PROXY_SHARED_SECRET) ---
# Lets per-IP rate limits see the real client IP for logins proxied by the Next.js app.
PROXY_SHARED_SECRET=change-me-shared-proxy-secret
